# Database Connection Configuration for Schema Validation Tests
# Copy this file to .env and update with your actual credentials

# Database host (localhost for local testing, RDS endpoint for AWS)
DB_HOST=localhost

# Database port (default PostgreSQL port)
DB_PORT=5432

# Database name
DB_NAME=trials_db

# Database user
DB_USER=vitalmatch_admin

# Database password (REQUIRED - set this before running tests)
DB_PASSWORD=your_password_here
