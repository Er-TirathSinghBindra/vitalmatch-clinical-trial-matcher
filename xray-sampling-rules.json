{
  "version": 2,
  "rules": [
    {
      "description": "VitalMatch Match Trials - High sampling for production",
      "host": "*",
      "http_method": "*",
      "url_path": "/match-trials",
      "fixed_target": 1,
      "rate": 0.1,
      "service_name": "*vitalmatch-match-trials*",
      "service_type": "*",
      "resource_arn": "*",
      "priority": 100,
      "attributes": {}
    },
    {
      "description": "VitalMatch Data Ingestion - Sample all invocations",
      "host": "*",
      "http_method": "*",
      "url_path": "*",
      "fixed_target": 1,
      "rate": 1.0,
      "service_name": "*vitalmatch-data-ingestion*",
      "service_type": "*",
      "resource_arn": "*",
      "priority": 200,
      "attributes": {}
    },
    {
      "description": "VitalMatch API Gateway - Sample 10% of requests",
      "host": "*",
      "http_method": "*",
      "url_path": "*",
      "fixed_target": 1,
      "rate": 0.1,
      "service_name": "*vitalmatch-api*",
      "service_type": "*",
      "resource_arn": "*",
      "priority": 300,
      "attributes": {}
    },
    {
      "description": "Default rule - Low sampling for everything else",
      "host": "*",
      "http_method": "*",
      "url_path": "*",
      "fixed_target": 1,
      "rate": 0.05,
      "service_name": "*",
      "service_type": "*",
      "resource_arn": "*",
      "priority": 1000,
      "attributes": {}
    }
  ],
  "default": {
    "fixed_target": 1,
    "rate": 0.05
  }
}
